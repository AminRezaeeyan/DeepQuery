# Copy to .env and fill in. Every variable is optional; the value shown is the
# default, except DEBUG, which defaults to False and is set for development here.

# --- Django ---
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
# Encrypts provider API keys stored in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from SECRET_KEY. Changing whichever is used makes
# stored API keys unreadable, so set them again in the admin after a change.
FIELD_ENCRYPTION_KEY=
# Comma-separated. Leave empty in development (localhost is allowed when DEBUG=True).
ALLOWED_HOSTS=
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Requests per client IP to sign-in, sign-up and token refresh.
AUTH_THROTTLE_RATE=10/minute

LOG_LEVEL=INFO

# --- PostgreSQL (needs the pgvector extension) ---
DB_NAME=deepquery
DB_USER=deepquery_user
DB_PASSWORD=deepquery_dev
DB_HOST=localhost
DB_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- External services ---
# Google sign-in. Must match VITE_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=
# Web search (ddgs, no API key). Search backends tried in order, comma-separated.
WEB_SEARCH_BACKENDS=duckduckgo,yahoo
WEB_SEARCH_TIMEOUT=10

# --- ZarinPal payments ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_SANDBOX=True
# The web client's address; ZarinPal sends users back to <CLIENT_URL>/payment/result.
CLIENT_URL=http://localhost:5173

# --- Retrieval ---
# Documents are split into passages of this many tokens (with overlap) for search.
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=60

# --- Research agent ---
# Tool-calling turns before the agent must answer.
AGENT_MAX_STEPS=10
# Check an answer against the tool results before sending it (one extra model turn).
AGENT_REVIEW=True

# --- Code execution (the agent's run_python tool) ---
# auto: bubblewrap if installed (isolates files and network), else a plain
# subprocess with limits (can read files the server user can). off: disabled.
CODE_SANDBOX=auto
CODE_TIMEOUT=20
CODE_MEMORY_MB=1024

# --- Uploads ---
DOCUMENT_MAX_UPLOAD_MB=20
CHAT_IMAGE_MAX_UPLOAD_MB=10

# --- Tokenizer cache (read by tiktoken, not by settings.py) ---
# Point this at a directory to keep tiktoken's tokenizer file locally, so the
# server doesn't need network access to download it. To fill the cache once:
#   TIKTOKEN_CACHE_DIR=<dir> python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
# TIKTOKEN_CACHE_DIR=
